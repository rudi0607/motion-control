# At least one generation backend is required.
# Self-hosted GPU worker (worker/) running open-source Wan2.2-Animate-14B, no third-party API
SELFHOSTED_WORKER_URL=
SELFHOSTED_WORKER_TOKEN=
SELFHOSTED_MAX_DURATION_SEC=30

# fal.ai — Kling v3 Motion Control (Pro / Standard) and Wan 2.2 Animate Move
FAL_KEY=
# Replicate — Wan 2.2 Animate (animation mode)
REPLICATE_API_TOKEN=

# Optional
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=200
